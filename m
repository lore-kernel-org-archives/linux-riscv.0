> +	unsigned int nr_irqs;
> +	unsigned long *priority_reg;

This isn't a pointer to registers. This is a save area for the
values. Please fix the naming.

>  };
>  
>  struct plic_handler {
> @@ -78,11 +81,13 @@ struct plic_handler {
>  	 */
