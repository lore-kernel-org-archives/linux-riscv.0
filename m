+	       pmd_t *pmd, bool write)
 {
 	pmd_t _pmd;
 
@@ -1562,88 +1562,6 @@ static inline bool can_change_pmd_writable(struct vm_area_struct *vma,
 	return pmd_dirty(pmd);
